.data-table td {
    padding: 10px 14px;
    border: 1px solid var(--border);
    color: var(--muted);
    vertical-align: top;
    line-height: 1.6;
}

.data-table tr:nth-child(even) td {
    background: rgba(255, 255, 255, 0.02);
}

/* ── CONTACT CARD ── */
.contact-card {
