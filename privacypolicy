}

.section p:last-child {
    margin-bottom: 0;
}

.section ul,
.section ol {
    margin: 12px 0 16px 0;
    padding-left: 0;
    list-style: none;
}

.section ul li,
.section ol li {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    padding: 5px 0 5px 22px;
    position: relative;
}

.section ul li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 14px;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
}

.section ol {
    counter-reset: ol;
}

.section ol li {
    counter-increment: ol;
}

.section ol li::before {
    content: counter(ol) ".";
    position: absolute;
    left: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    top: 6px;
}

