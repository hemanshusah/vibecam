.footer-links a:hover {
    color: var(--accent);
}

.footer-links a.active {
    color: var(--accent);
}

@media (max-width: 600px) {
    .toc ol {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 40px 16px 32px;
    }

    .page-wrap {
        padding: 0 16px 60px;
    }
}

